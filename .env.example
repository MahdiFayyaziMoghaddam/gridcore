# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/gridcore

# ─── NextAuth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32  (32+ chars required)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── OAuth (optional) ──────────────────────────────────────────
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storage ───────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
BLOB_STORAGE_REGION=auto

# ─── WebSocket ─────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/websocket

# ─── Testing (optional) ────────────────────────────────────────
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/gridcore_test
TEST_BASE_URL=http://localhost:3000
TEST_WS_URL=ws://localhost:3000/api/websocket